# NewsX Root GitIgnore

# --- Miscellaneous / OS Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*.tmp
tmp/
logs/
*.log

# --- Secrets, Credentials & Environment Configs ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
*.keystore
key.properties
local.properties
firebase_admin.json
google-services.json
GoogleService-Info.plist

# --- Node.js & Package Managers ---
node_modules/
backend/node_modules/
admin/node_modules/
package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/

# --- Build Outputs & Bundles ---
dist/
admin/dist/
build/
coverage/

# --- Flutter & Dart ---
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
doc/api/
lib/generated_plugin_registrant.dart

# --- Android & Gradle ---
.gradle/
android/.gradle/
android/captures/
android/app/build/

# --- iOS / Xcode ---
ios/Pods/
ios/.symlinks/
ios/Runner.xcworkspace/
ios/Runner.xcodeproj/project.xcworkspace/
ios/Runner.xcodeproj/xcuserdata/

# --- IDEs & Editors ---
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
