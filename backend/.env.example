# Server Config
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# MySQL Hostinger Database Config
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=newsx_db

# Security & Authentication
JWT_SECRET=newsx_super_secret_jwt_key_2026_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Google Gemini AI Config
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-1.5-flash

# Background Cron Worker Schedules (Standard Cron Syntax)
CRON_RSS_SCHEDULE=*/10 * * * *
CRON_AI_SCHEDULE=*/5 * * * *
CRON_TRENDING_SCHEDULE=0 * * * *
CRON_CLEANUP_SCHEDULE=0 0 * * *

# CORS Config
ALLOWED_ORIGINS=*
